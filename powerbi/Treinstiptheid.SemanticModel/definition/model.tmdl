model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataUrl", "dag_station", "dag_relatie", "dag_uur", "stations", "officieel", "oorzaken"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table Datum
ref table dag_station
ref table dag_relatie
ref table dag_uur
ref table stations
ref table officieel
ref table oorzaken
