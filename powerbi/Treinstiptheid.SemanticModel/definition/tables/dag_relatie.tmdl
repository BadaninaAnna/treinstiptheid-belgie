table dag_relatie
	lineageTag: 384d585f-e344-44d4-8678-e523eea73eac

	measure 'Stiptheid lijn' = DIVIDE ( SUM ( dag_relatie[stipt] ), SUM ( dag_relatie[metingen] ) )
		formatString: 0.0%
		displayFolder: Lijnen
		lineageTag: b47dabcc-f4ce-4ce0-98a6-e953bc4ed87e

	measure 'Aankomsten lijn' = SUM ( dag_relatie[metingen] )
		formatString: #,0
