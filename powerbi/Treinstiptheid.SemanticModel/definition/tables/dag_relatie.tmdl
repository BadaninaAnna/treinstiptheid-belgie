	partition dag_relatie = m
		mode: import
		source =
			let
			    Vandaag = Date.From ( DateTime.LocalNow () ),
			    Start = #date ( 2026, 8, 1 ),
			    Aantal = ( Date.Year ( Vandaag ) - 2026 ) * 12 + Date.Month ( Vandaag ) - 8 + 1,
			    Maanden = List.Transform ( { 0 .. Aantal - 1 }, each Date.ToText ( Date.AddMonths ( Start, _ ), "yyyy-MM", "en-US" ) ),
			    Lees = ( m as text ) =>
			        try Table.PromoteHeaders ( Csv.Document ( Web.Contents ( DataUrl & "dag/dag_relatie/" & m & ".csv" ), [Delimiter = ",", Encoding = 65001] ), [PromoteAllScalars = true] )
			        otherwise null,
			    Samen = Table.Combine ( List.RemoveNulls ( List.Transform ( Maanden, Lees ) ) ),
			    Types = Table.TransformColumnTypes ( Samen, {{"datum", type date}, {"relatie", type text}, {"operator", type text}, {"metingen", Int64.Type}, {"stipt", Int64.Type}, {"gem_vertraging_min", type number}, {"zwaar_vertraagd", Int64.Type}, {"treinen", Int64.Type}}, "en-US" )
			in
			    Types

	annotation PBI_ResultType = Table
