		dataType: dateTime
		formatString: dd-mm-yyyy
		lineageTag: 1a3a6109-5d91-4061-b70e-c8cf9d03d0e4
		summarizeBy: none
		sourceColumn: datum

		annotation SummarizationSetBy = Automatic

	column station
