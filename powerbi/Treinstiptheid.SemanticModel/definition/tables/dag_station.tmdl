table dag_station
	lineageTag: 386802bf-6074-40af-b77a-00668edefd65

	measure Stiptheid = DIVIDE ( SUM ( dag_station[stipt] ), SUM ( dag_station[metingen] ) )
		formatString: 0.0%
		displayFolder: Stiptheid
		lineageTag: 1967616f-0353-4c22-8d51-05c6f3048643

	measure 'Stiptheid netwerk' = CALCULATE ( [Stiptheid], REMOVEFILTERS ( stations ) )
		formatString: 0.0%
		displayFolder: Stiptheid
		lineageTag: 41b13000-8f03-4ebd-b918-97fb1a904900

	measure 'Verschil met netwerk (pp)' = ( [Stiptheid] - [Stiptheid netwerk] ) * 100
		formatString: +0.0;-0.0;0.0
		displayFolder: Stiptheid
		lineageTag: 9e13ad74-b9f5-4f83-8fd8-ba1e2a2885d7

	measure Aankomsten = SUM ( dag_station[metingen] )
		formatString: #,0
		displayFolder: Stiptheid
		lineageTag: 5bc0e293-31b7-4b20-a5b0-1a901ad9567e

	measure 'Gem. vertraging (min)' = DIVIDE ( SUM ( dag_station[vertragingsminuten] ), SUM ( dag_station[metingen] ) )
		formatString: 0.00
		displayFolder: Stiptheid
		lineageTag: 3696d16d-1653-40c1-9d5c-b0df6fe651d2

	measure 'Zwaar vertraagd' = SUM ( dag_station[zwaar_vertraagd] )
		formatString: #,0
		displayFolder: Stiptheid
		lineageTag: 5c259d7b-6d01-4139-9b8d-419df833a686

	measure 'Laatste dag' = CALCULATE ( MAX ( dag_station[datum] ), REMOVEFILTERS () )
		formatString: dd-mm-yyyy
		displayFolder: Stiptheid
		lineageTag: 5919e911-741e-4b14-8480-3b3fbaebe5e5

	measure 'Stiptheid laatste dag' =
			VAR d = [Laatste dag]
			RETURN CALCULATE ( [Stiptheid], REMOVEFILTERS ( Datum ), dag_station[datum] = d )
		formatString: 0.0%
		displayFolder: Stiptheid
		lineageTag: a3c5fe75-cf4e-4123-884f-cc200d515664

