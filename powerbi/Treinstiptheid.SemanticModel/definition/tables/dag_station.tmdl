		summarizeBy: sum
		sourceColumn: vertragingsminuten

		annotation SummarizationSetBy = Automatic

	partition dag_station = m
		mode: import
		source =
			let
			    Vandaag = Date.From ( DateTime.LocalNow () ),
			    Start = #date ( 2026, 8, 1 ),
			    Aantal = ( Date.Year ( Vandaag ) - 2026 ) * 12 + Date.Month ( Vandaag ) - 8 + 1,
			    Maanden = List.Transform ( { 0 .. Aantal - 1 }, each Date.ToText ( Date.AddMonths ( Start, _ ), "yyyy-MM", "en-US" ) ),
			    Lees = ( m as text ) =>
			        try Table.PromoteHeaders ( Csv.Document ( Web.Contents ( DataUrl & "dag/dag_station/" & m & ".csv" ), [Delimiter = ",", Encoding = 65001] ), [PromoteAllScalars = true] )
			        otherwise null,
			    Samen = Table.Combine ( List.RemoveNulls ( List.Transform ( Maanden, Lees ) ) ),
			    Types = Table.TransformColumnTypes ( Samen, {{"datum", type date}, {"station", type text}, {"metingen", Int64.Type}, {"stipt", Int64.Type}, {"gem_vertraging_min", type number}, {"p90_vertraging_min", type number}, {"zwaar_vertraagd", Int64.Type}, {"vertragingsminuten", type number}}, "en-US" )
			in
			    Types

	annotation PBI_ResultType = Table
